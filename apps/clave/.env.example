# Firebase Configuration
# Copy this file to .env and fill in your real Firebase project values.
# Run `flutterfire configure` to get these values.

API_URL=https://api.kurlydeer.com

# Firebase Web Config (required for web builds)
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MEASUREMENT_ID=
